{
	"name": "jmconwell.com",
	"version": "0.3.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"deploy": "npm run build && wrangler deploy",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"devicon": "^2.17.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.105.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"wrangler": "^4.141.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/comfortaa": "^5.3.0",
		"@fontsource/fira-code": "^5.3.0",
		"@fontsource/fira-mono": "^5.3.0",
		"@fontsource/inconsolata": "^5.3.0",
		"chota": "^0.9.2"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"@parcel/watcher@2.6.0": true,
		"workerd@1.20260925.1": true
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"cookie": "^1.0.2"
	}
}
